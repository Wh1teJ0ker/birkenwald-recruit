DATABASE_URL=postgres://birkenwald:birkenwald_dev@localhost:5432/birkenwald?sslmode=disable
HTTP_ADDR=:8080
UPLOAD_DIR=./data/uploads
WEB_DIST=./frontend/dist
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-this-before-deployment
COOKIE_SECURE=false
PLUGIN_TIMEOUT=45s

# 学生注册需要邮箱验证码。本地开发可将 EMAIL_DEV_MODE 设为 true：
# 不发送邮件，验证码写入日志并随发送接口返回。生产环境必须保持 false。
# 启动后也可在管理台「基础设置 → 邮件与注册」中填写，页面配置优先于这里。
EMAIL_DEV_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.org
